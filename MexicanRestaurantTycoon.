-- TREES
local function createTree(x, z)
	local tree = model("Plaza Tree")

	part("Trunk", Vector3.new(3, 12, 3),
		Vector3.new(x, 6, z), brown, Enum.Material.Wood, tree)

	local leaves = part("Leaves", Vector3.new(13, 13, 13),
		Vector3.new(x, 15, z), green, Enum.Material.Grass, tree)

	leaves.Shape = Enum.PartType.Ball
end

for x = -140, 140, 35 do
	createTree(x, -140)
	createTree(x, 140)
end

for z = -105, 105, 35 do
	createTree(-140, z)
	createTree(140, z)
end

-- STREET LAMPS
local function createLamp(x, z)
	local lamp = model("Street Lamp")

	part("Pole", Vector3.new(1, 13, 1),
		Vector3.new(x, 6.5, z), dark, Enum.Material.Metal, lamp)

	local lightPart = part("Lamp", Vector3.new(3, 2, 3),
		Vector3.new(x, 13, z), Color3.fromRGB(255, 220, 140),
		Enum.Material.Neon, lamp)

	local light = Instance.new("PointLight")
	light.Brightness = 2
	light.Range = 22
	light.Parent = lightPart
end

for x = -100, 100, 50 do
	createLamp(x, -35)
	createLamp(x, 35)
end

