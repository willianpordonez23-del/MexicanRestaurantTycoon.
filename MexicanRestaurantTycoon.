-- RESTAURANT PLOT
local function createRestaurant(name, x, z, number)
	local plot = model(name)

	part("Plot Floor", Vector3.new(66, 1, 66),
		Vector3.new(x, 0.5, z), Color3.fromRGB(190, 165, 125),
		Enum.Material.Concrete, plot)

	-- BUILDING WALLS
	part("Back Wall", Vector3.new(38, 16, 2),
		Vector3.new(x, 9, z + 12), cream, Enum.Material.Plaster, plot)

	part("Left Wall", Vector3.new(2, 16, 24),
		Vector3.new(x - 18, 9, z), cream, Enum.Material.Plaster, plot)

	part("Right Wall", Vector3.new(2, 16, 24),
		Vector3.new(x + 18, 9, z), cream, Enum.Material.Plaster, plot)

	-- ROOF
	part("Red Roof", Vector3.new(42, 2, 30),
		Vector3.new(x, 18, z), red, Enum.Material.RoofShingles, plot)

	-- FRONT COUNTER
	part("Restaurant Counter", Vector3.new(25, 4, 3),
		Vector3.new(x, 3, z - 9), brown, Enum.Material.Wood, plot)

	part("Counter Top", Vector3.new(26, 0.6, 4),
		Vector3.new(x, 5.3, z - 9), cream, Enum.Material.Marble, plot)

	-- KITCHEN
	part("Kitchen Counter", Vector3.new(12, 3, 3),
		Vector3.new(x - 10, 2.5, z + 5), dark, Enum.Material.Metal, plot)

	part("Cooking Station", Vector3.new(5, 2, 4),
		Vector3.new(x - 10, 5, z + 5), orange, Enum.Material.Metal, plot)

	-- SIGN
	local sign = part("Restaurant Sign", Vector3.new(20, 4, 1),
		Vector3.new(x, 14, z - 13), red, Enum.Material.Wood, plot)

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.Parent = sign

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "RESTAURANT " .. number
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui

	-- TABLES
	for i = 1, 3 do
		local tx = x - 12 + (i * 12)

		part("Patio Table", Vector3.new(6, 0.5, 6),
			Vector3.new(tx, 3, z - 23), brown, Enum.Material.Wood, plot)

		for _, offset in ipairs({
			Vector3.new(-2, 1, -2),
			Vector3.new(2, 1, -2),
			Vector3.new(-2, 1, 2),
			Vector3.new(2, 1, 2)
		}) do
			part("Chair", Vector3.new(2, 2, 2),
				Vector3.new(tx + offset.X, 2, z - 23 + offset.Z),
				red, Enum.Material.Wood, plot)
		end
	end

	-- DECORATION
	for i = -2, 2 do
		part("Wall Decoration", Vector3.new(3, 3, 0.3),
			Vector3.new(x + i * 6, 9, z + 10),
			orange, Enum.Material.SmoothPlastic, plot)
	end
end

